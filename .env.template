# Core Application Environment Variables
# =====================================

# AI Model Configuration (Required)
MODEL_DEPLOYMENT_NAME=
AI_API_KEY=
AI_ENDPOINT=
API_VERSION=2025-01-01-preview

# Azure AI Foundry Configuration (Optional - for enhanced processing)
# ================================================================
# If these variables are provided, the application will use Azure AI Foundry agents
# for enhanced document analysis. If not provided, it falls back to standard processing.

# Azure AI Foundry Project Endpoint
AZURE_AI_PROJECT_ENDPOINT=h

# Agent IDs for the sequential workflow
ARCHITECTURE_EXTRACTOR_AGENT_ID=
AZURE_RESOURCES_SPECIALIST_AGENT_ID=

# Azure Identity Configuration (Optional)
# =====================================
# For Azure AI Foundry authentication - if not provided, DefaultAzureCredential will be used

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Application Configuration (Optional)
# ==================================

# API Server Configuration
HOST=0.0.0.0
PORT=8080
RELOAD=false

# Graceful Shutdown Configuration
SHUTDOWN_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO