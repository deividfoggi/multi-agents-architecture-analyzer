# Core Application Environment Variables
# =====================================

# Azure OpenAI Configuration (Required)
# ====================================
# Azure OpenAI API Key
AZURE_OPENAI_API_KEY=

# Azure OpenAI Endpoint (format: https://your-resource.openai.azure.com)
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI Deployment Name (the name of your GPT-4 deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Azure OpenAI API Version
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Legacy Environment Variables (Backward Compatibility)
# ==================================================
# If you prefer, you can still use these legacy variables:
# MODEL_DEPLOYMENT_NAME (maps to AZURE_OPENAI_DEPLOYMENT)
# AI_API_KEY (maps to AZURE_OPENAI_API_KEY)
# AI_ENDPOINT (maps to AZURE_OPENAI_ENDPOINT)
# API_VERSION (maps to AZURE_OPENAI_API_VERSION)

# Tool Configuration (Optional - defaults provided if not set)
# ===========================================================

# MCP Server Configuration (used by specialist agents for Microsoft Learn docs)
# Default: https://learn.microsoft.com/api/mcp
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_SERVER_LABEL=microsoft_learn

# Application Configuration (Optional)
# ==================================

# API Server Configuration
HOST=0.0.0.0
PORT=8080
RELOAD=false

# Graceful Shutdown Configuration
SHUTDOWN_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO

# ========================================
# NOTE: Agent IDs are NO LONGER REQUIRED!
# ========================================
# In v2.0, agents are created dynamically through the UI.
# The following variables from v1.0 are DEPRECATED:
# - ARCHITECTURE_EXTRACTOR_AGENT_ID
# - AZURE_RESOURCES_SPECIALIST_AGENT_ID
# - AZURE_INFRASTRUCTURE_SPECIALIST_AGENT_ID
# - AZURE_DATABASE_SPECIALIST_AGENT_ID
# - AZURE_CONTAINERS_SPECIALIST_AGENT_ID
# - AZURE_COMPUTE_SPECIALIST_AGENT_ID
# - AZURE_CALCULATOR_SPECIALIST_AGENT_ID