# API Configuration
HOST=0.0.0.0
PORT=8080
RELOAD=false

# AI Service Configuration (you need to fill these with your actual values)
AI_MODEL_NAME=your_model_name
AI_API_KEY=your_api_key  
AI_ENDPOINT=your_endpoint_url
API_VERSION=2024-02-15-preview

# Azure Storage Configuration (you need to fill these with your actual values)
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string
PROMPT_TEMPLATE_CONTAINER_NAME=your_container_name
PROMPT_TEMPLATE_BLOB_NAME=essay.yaml

# Optional Configuration
SHUTDOWN_TIMEOUT=30